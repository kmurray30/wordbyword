{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	rewrite /health /*

	root * dist
	encode gzip

	# The HTML shell must always be revalidated: without an explicit
	# Cache-Control, Safari (and especially a home-screen web app) keeps
	# serving a stale index.html - and so the OLD build's JS - for a long
	# time after a deploy. Vite's hashed assets, on the other hand, never
	# change under the same name, so they can be cached forever.
	@html path / /index.html /*.html
	header @html Cache-Control "no-cache, must-revalidate"
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	file_server
	try_files {path} /index.html
}
